spring.application.name=tp_spring_grupal
# Configuracion de base de datos PostgreSQL
spring.datasource.url=jdbc:postgresql://localhost:5432/facturacion_db
spring.datasource.driver-class-name=org.postgresql.Driver
spring.datasource.username=postgres
spring.datasource.password=CAMBIAR

# Dialecto
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect

# Configuracion de Hibernate/JPA
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.default_schema=facturacion

# Configuración de AFIP / ARCA
afip.cuit=CAMBIAR
afip.keystore.path=classpath:certificado.pfx
afip.keystore.password=CAMBIAR
afip.wsaa.url=https://wsaahomo.afip.gov.ar/ws/services/LoginCms
afip.wsfe.url=https://wswhomo.afip.gov.ar/wsfev1/service.asmx

# Emisor: RESPONSABLE_INSCRIPTO (comprobantes A/B, discrimina IVA) | MONOTRIBUTO | EXENTO (comprobante C)
afip.condicion-iva-emisor=MONOTRIBUTO

# Datos del emisor que se imprimen en la cabecera del PDF de la factura (el CUIT es afip.cuit)
afip.razon-social=CAMBIAR
afip.domicilio-comercial=CAMBIAR
afip.ingresos-brutos=CAMBIAR
# Fecha de inicio de actividades (yyyy-MM-dd)
afip.inicio-actividades=2020-01-01

# La cantidad de un renglon es entera: 1.5 se rechaza con 400 en vez de truncarse a 1
spring.jackson.deserialization.accept-float-as-int=false

# Punto de venta de Web Services (alta en ARCA) y timeouts de red hacia ARCA
afip.punto-venta=2
afip.timeout.connect-ms=10000
afip.timeout.read-ms=30000
# Tope por comprobante para Consumidor Final sin identificar
afip.consumidor-final-monto-maximo=10000000
